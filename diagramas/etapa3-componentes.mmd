%% Etapa 3 · Componentes y dirección de las dependencias
%% ·
%% Reglas que el marcador verifica:
%%   · Tres subgrafos, con estos nombres:  dominio, aplicacion, infraestructura
%%   · CERO flechas que salgan de dominio hacia infraestructura
%%   · CERO flechas que salgan de dominio hacia aplicacion
%%   · Al menos dos componentes en cada subgrafo
%%   · Los puertos que declaró en cafetrace/dominio/puertos.py aparecen aquí
%% ·
%% Esta es la lámina donde se ve si entendió la inversión de dependencias:
%% las flechas apuntan HACIA el dominio, nunca desde él.
%% ·
%% Así se escribe (el contenido es suyo):
%% ·
%%     flowchart TD
%%         subgraph dominio[dominio]
%%             cosa[Una entidad]
%%             puerto[/UnPuerto/]
%%         end
%%         subgraph infraestructura[infraestructura]
%%             adaptador[Quien lo implementa]
%%         end
%%         adaptador -.implementa.-> puerto
%% ·
%% Dibújelo primero a mano. La foto va en BOSQUEJOS/etapa3.jpg.

flowchart TD
    subgraph dominio[dominio]
        Lote[Entidad Lote]
        Peso[Valor Peso]
        RepositorioDeLotes[/Puerto RepositorioDeLotes/]
        Reloj[/Puerto Reloj/]
        PrecioDelDia[/Puerto PrecioDelDia/]
        Bitacora[/Puerto Bitacora/]
    end

    subgraph aplicacion[aplicacion]
        CasoRecibo[Caso de Uso: Registrar Recibo]
        CasoLiquidacion[Caso de Uso: Calcular Liquidación]
    end

    subgraph infraestructura[infraestructura]
        AdaptadorDB[Adaptador: Repositorio PostgreSQL]
        ControladorAPI[Controlador: API FastAPI]
        AdaptadorReloj[Adaptador: Reloj Sistema]
        AdaptadorPrecio[Adaptador: API Precio BCCR]
    end

    %% Dirección de las dependencias: NINGUNA sale de dominio
    CasoRecibo --> Lote
    CasoRecibo --> RepositorioDeLotes
    CasoRecibo --> Reloj
    CasoLiquidacion --> Lote
    CasoLiquidacion --> PrecioDelDia

    AdaptadorDB -.-> RepositorioDeLotes
    AdaptadorReloj -.-> Reloj
    AdaptadorPrecio -.-> PrecioDelDia
    ControladorAPI --> CasoRecibo