%% Etapa 5 · La entrega que llega dos veces
%% ·
%% Reglas que el marcador verifica:
%%   · Es un sequenceDiagram
%%   · Al menos tres participantes, y entre ellos la tableta y la API
%%   · Al menos cuatro mensajes
%%   · Al menos un bloque  alt  u  opt : la rama de «ya había llegado»
%%   · Los identificadores llevan solo letras, números y guion bajo
%% ·
%% Así se escribe (el contenido es suyo):
%% ·
%%     sequenceDiagram
%%         participant X as Quien pide
%%         participant Y as Quien responde
%%         X->>Y: lo que le pide
%%         Y-->>X: lo que le contesta
%%         alt cuando pasa una cosa
%%             Y-->>X: una respuesta
%%         else cuando pasa la otra
%%             Y-->>X: la otra
%%         end
%% ·
%% Lo que tiene que quedar claro en el dibujo: qué pasa la primera vez que
%% llega la entrega, y qué pasa la segunda.
%% ·
%% Dibújelo primero a mano. La foto va en BOSQUEJOS/etapa5.jpg.

sequenceDiagram
    autonumber
    participant tableta as Tableta del recibidor
    participant api as API Central Borde
    participant caso as RegistrarEntrega
    participant repo as RepositorioDeLotes

    tableta->>api: ejecutar_solicitud(datos)
    api->>caso: ejecutar(solicitud, id_lote)
    caso->>repo: entrega_registrada(id_entrega)
    repo-->>caso: booleano (existe o no)

    alt primera vez que llega (no existe)
        caso->>repo: guardar(lote_nuevo)
        caso-->>api: Comprobante(duplicado=False)
        api-->>tableta: Comprobante impreso
    else segunda vez que llega (ya habia llegado)
        caso-->>api: Comprobante(duplicado=True)
        api-->>tableta: Mismo comprobante de exito
    end
