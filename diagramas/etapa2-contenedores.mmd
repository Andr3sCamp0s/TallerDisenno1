%% Etapa 2 · Contenedores (C4 nivel 2)
%% ·
%% Reglas que el marcador verifica:
%%   · Los contenedores propios van dentro de  subgraph cafetrace[CafeTrace]
%%   · Lo de afuera va dentro de  subgraph externos[Externos]
%%   · Cada contenedor propio dice su tecnología entre paréntesis
%%   · Cada flecha dice el protocolo o el medio: HTTPS, SQL, archivo, evento…
%%   · Tiene que aparecer la tableta del recibidor
%%   · El contenedor que nombró en D2.2 tiene que existir aquí
%%   · Su respuesta de D2.1 tiene que cuadrar con cuántos desplegables dibujó
%% ·
%% Así se escribe (el contenido es suyo):
%% ·
%%     flowchart TD
%%         subgraph cafetrace[CafeTrace]
%%             algo["Nombre del contenedor (tecnología)"]
%%             base[("Nombre (PostgreSQL)")]
%%         end
%%         subgraph externos[Externos]
%%             otro[Alguien de afuera]
%%         end
%%         algo -->|SQL| base
%%         algo -->|archivo mensual| otro
%% ·
%% Un «desplegable» es algo que se arranca y se actualiza por su cuenta.
%% Una base de datos no cuenta como desplegable suyo.
%% ·
%% Dibújelo primero a mano. La foto va en BOSQUEJOS/etapa2.jpg.

flowchart TD
    subgraph cafetrace[CafeTrace]
        tableta["Tableta del recibidor (Android)"]
        db_local[("Base de Datos Embebida (SQLite)")]
        servidor["Servidor Central (FastAPI)"]
        db_central[("Base de Datos Principal (PostgreSQL)")]

        tableta -->|SQL| db_local
        tableta -->|HTTPS| servidor
        servidor -->|SQL| db_central
    end

    subgraph externos[Externos]
        Productor[Productor]
        Auditor[Auditor de Certificación]
        ICAFE[Sistema ICAFE]
        Aduana[API Aduanas]
        ServicioPrecio[Servicio de Precio]
        Exportador[Exportador]
        Gerente[Gerente de Cooperativa]
    end

    %% Relaciones externas puras basadas en la tupla estricta PROTOCOLOS
    Productor -->|evento| tableta
    tableta -->|evento| Productor
    servidor -->|HTTPS| Auditor
    servidor -->|archivo| ICAFE
    servidor -->|HTTPS| Aduana
    ServicioPrecio -->|HTTPS| servidor
    Exportador -->|HTTPS| servidor
    Gerente -->|HTTPS| servidor